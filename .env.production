APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:ZdzUnJb+rZ5sJY0jtwRqDVOauctOb72qDBizdSYWOZk=
APP_DEBUG=true
APP_URL=https://accounts.spurs.com.ng

# Spurs SSO shared session (Google-style: one cookie across all first-party apps).
# The secret MUST match every first-party app (baas/pay/wallet/cloud verify it).
SPURS_SESSION_SECRET="abcdefghijklmnopqrstuvwxyz012345"
SPURS_SESSION_COOKIE=spurs_session
# Dev: leave domain empty (host-only 'localhost', shared across localhost:* ports).
# Prod: SPURS_COOKIE_DOMAIN=.spurs.com.ng  and  SPURS_COOKIE_SECURE=true
SPURS_COOKIE_DOMAIN=.spurs.com.ng
SPURS_COOKIE_SECURE=false
# First-party OIDC client IDs — hidden from "Connected apps" (baas,pay,wallet,cloud).
SPURS_FIRST_PARTY_CLIENTS=019f73a7-933a-7161-ad96-f709b1c22bc8,019f7a38-44c5-71fc-a9f7-68991fd2c486,019f7a18-bf65-717e-a3a6-e4bb5a5b4ab3,019f7a5c-d2ae-73d2-8041-e6cb12356c96

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
